@page
@model ErrorModel
@{
    ViewData["Title"] = Model.IsNotFound ? "404 — Page not found" : "Something went wrong";
}

<div style="text-align:center;padding:3.5rem 1rem;min-height:52vh;">
    <div style="font-size:5.5rem;font-weight:800;color:#f26822;line-height:1;">@Model.Code</div>
    @if (Model.IsNotFound)
    {
        <h2 style="margin:.5rem 0 .75rem;">Page not found</h2>
        <p style="opacity:.75;max-width:460px;margin:0 auto 1.75rem;line-height:1.5;">
            This page doesn&#39;t exist, was moved, or never did.
        </p>
    }
    else
    {
        <h2 style="margin:.5rem 0 .75rem;">Something went wrong</h2>
        <p style="opacity:.75;max-width:460px;margin:0 auto 1.75rem;line-height:1.5;">
            An error occurred while processing your request. Please try again.
        </p>
    }
    <a href="/" style="display:inline-block;padding:.7rem 1.2rem;border-radius:8px;background:#f26822;color:#111;font-weight:700;text-decoration:none;">
        ← Back to home
    </a>
</div>
