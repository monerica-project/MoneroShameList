@page
@using MoneroShameList.Helpers
@using MoneroShameList.Models
@model IndexModel
@{
    ViewData["Title"] = "The Monero Shame List";

    string Url(string? tab = null, string? sort = null, string? category = null, string? view = null, int? page = null)
    {
        var t = tab ?? Model.Tab;
        var s = sort ?? Model.Sort;
        var c = category ?? Model.CategoryFilter ?? "";
        var v = view ?? Model.ViewMode;
        var p = page ?? Model.Page;
        var qs = $"?tab={t}&sort={s}&view={v}&page={p}";
        if (!string.IsNullOrEmpty(c)) qs += $"&category={c}";
        return qs;
    }

    var reasons = new (string Value, string Label)[]
    {
        ("", "All reasons"),
        ("NeverAdded", "Never Added XMR"),
        ("DelistedXmr", "Delisted XMR"),
        ("AllowsOtherCrypto", "Other Crypto Only"),
        ("Scammer", "Scammer"),
    };
}

<div class="hero">
    <div class="hero-logo-wrap">
        <img src="/images/monero-symbol-on-white-480.png" alt="Monero" class="hero-logo" />
    </div>
    <h1>The <span>Privacy Hypocrite</span> Shame List</h1>
    <p>Companies that market themselves as privacy-focused but refuse to accept Monero — the only truly private money.</p>
    <a href="/submit" class="btn btn-primary">Submit a Company</a>
</div>

<div class="index-tabs">
    <a href="@Url(tab: "shame", category: "", page: 1)" class="index-tab @(Model.Tab == "shame" ? "active" : "")">
        Shame List <span class="tab-count">@Model.ShameCount</span>
    </a>
    <a href="@Url(tab: "mixed", category: "", page: 1)" class="index-tab index-tab-mixed @(Model.Tab == "mixed" ? "active" : "")">
        Mixed Support <span class="tab-count">@Model.MixedCount</span>
    </a>
    <a href="@Url(tab: "converted", category: "", page: 1)" class="index-tab index-tab-converted @(Model.Tab == "converted" ? "active" : "")">
        Converted ✅ <span class="tab-count">@Model.ConvertedCount</span>
    </a>
</div>

<div class="list-controls">
    <div class="lc-group">
        <span class="lc-label">View:</span>
        <a href="@Url(view: "cards", page: 1)" class="lc-link @(Model.ViewMode == "cards" ? "active" : "")">Cards</a>
        <a href="@Url(view: "table", page: 1)" class="lc-link @(Model.ViewMode == "table" ? "active" : "")">Table</a>
    </div>
    <div class="lc-group">
        <span class="lc-label">Sort:</span>
        <a href="@Url(sort: "date", page: 1)" class="lc-link @(Model.Sort == "date" ? "active" : "")">Newest</a>
        <a href="@Url(sort: "date-asc", page: 1)" class="lc-link @(Model.Sort == "date-asc" ? "active" : "")">Oldest</a>
        <a href="@Url(sort: "name", page: 1)" class="lc-link @(Model.Sort == "name" ? "active" : "")">A–Z</a>
        <a href="@Url(sort: "name-desc", page: 1)" class="lc-link @(Model.Sort == "name-desc" ? "active" : "")">Z–A</a>
    </div>
    @if (Model.Tab == "shame")
    {
        <div class="lc-group">
            <span class="lc-label">Reason:</span>
            @foreach (var r in reasons)
            {
                var isActive = (Model.CategoryFilter ?? "") == r.Value;
                <a href="@Url(category: r.Value, page: 1)" class="lc-link @(isActive ? "active" : "")">@r.Label</a>
            }
        </div>
    }
</div>

@if (Model.Tab == "mixed")
{
    <p class="tab-description">These companies have partial or unofficial Monero support — they accept it through a third party or don't promote it openly.</p>
}
else if (Model.Tab == "converted")
{
    <p class="tab-description">These companies were on the shame list and have since added proper Monero support.</p>
}

<p class="entry-count">
    @Model.TotalCount compan@(Model.TotalCount == 1 ? "y" : "ies")@(Model.TotalPages > 1 ? $" · page {Model.Page} of {Model.TotalPages}" : "")
</p>

@if (Model.ViewMode == "table")
{
    @await Html.PartialAsync("_EntryTable", Model.Entries)
}
else
{
    @await Html.PartialAsync("_EntryList", Model.Entries)
}

@if (Model.TotalPages > 1)
{
    <nav class="pager" aria-label="Pagination">
        @if (Model.Page > 1)
        {
            <a class="pager-link" href="@Url(page: Model.Page - 1)" rel="prev">← Prev</a>
        }
        else
        {
            <span class="pager-link disabled">← Prev</span>
        }

        <span class="pager-info">Page @Model.Page of @Model.TotalPages</span>

        @if (Model.Page < Model.TotalPages)
        {
            <a class="pager-link" href="@Url(page: Model.Page + 1)" rel="next">Next →</a>
        }
        else
        {
            <span class="pager-link disabled">Next →</span>
        }
    </nav>
}
